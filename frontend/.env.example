# Copy to .env for local `npm run dev`. Docker builds need none of this.
# Use the in-browser mock instead of the real services (UI work without the backend).
VITE_USE_MOCK=false

# Service URLs default to http://<page host>:<port>, which works on any laptop.
# Only set these to point at a different machine.
# VITE_LISTING_API=http://localhost:8001
# VITE_BIDDING_API=http://localhost:8002
# VITE_TIMER_API=http://localhost:8003
# VITE_PAYMENT_API=http://localhost:8004
# VITE_NOTIFICATION_API=http://localhost:8005
# VITE_NOTIFICATION_WS=ws://localhost:8005
# VITE_RABBIT_MGMT=http://localhost:15672
